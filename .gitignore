# Keep only the reviewed static app and its deployment configuration.
/*
!/.gitignore
!/.nojekyll
!/README.md
!/index.html
!/app.js
!/enhancements.css
!/questions.json
!/explanations.json
!/manifest.webmanifest
!/sw.js
!/icon-192.png
!/icon-512.png
!/assets/
/assets/*
!/assets/questions/
/assets/questions/*
!/assets/questions/*.png
!/题库导入报告.md
!/题源疑点清单.md
!/验收结果.md
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/pages.yml
